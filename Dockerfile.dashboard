# 1. 파이썬 경량 이미지 사용
FROM python:3.12-slim

# 2. 작업 디렉토리 설정
WORKDIR /app

# 3. 필요한 파일 복사
COPY dashboard.py .
# 라이브러리 목록이 적힌 파일이 있다면 복사 (없으면 아래 RUN 명령어로 설치)
# COPY requirements.txt . 

# 4. 필수 라이브러리 설치 (대시보드 운영용)
RUN pip install --no-cache-dir streamlit plotly boto3 pandas

# 5. Streamlit 기본 포트(8501) 개방
EXPOSE 8501

# 6. 실행 명령어 (외부 접속 허용 설정 포함)
CMD ["streamlit", "run", "dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]